OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_DEFAULT_MODEL=openrouter/free
AI_STUDIO_ENVIRONMENT=development
AI_STUDIO_DEBUG=true
AI_STUDIO_HOST=127.0.0.1
AI_STUDIO_PORT=8000
AI_STUDIO_MAX_TOKENS=1000
AI_STUDIO_TEMPERATURE=0.4
AI_STUDIO_REQUEST_TIMEOUT_SECONDS=60

# P2-007 Code Sandbox
# Additional trusted Git roots, separated by semicolons on Windows.
# The AI Studio repository itself is always allowed.
# AI_STUDIO_CODE_SANDBOX_ALLOWED_ROOTS=C:\Projects\another-project;D:\Work\trusted-repo
# Host pytest/npm build execution is OFF by default; enable only for trusted repositories.
AI_STUDIO_CODE_SANDBOX_ALLOW_TEST_EXECUTION=0

# P2-009 Multi-Provider Model Gateway
# Preferred: store provider keys in Secret Manager and reference them here.
# AI_STUDIO_OPENROUTER_SECRET_REF=secret://...
# AI_STUDIO_SVRTR_SECRET_REF=secret://...
# Legacy local fallback only:
# SVRTR_API_KEY=sk-sr-v1-...
AI_STUDIO_SVRTR_BASE_URL=https://api.svrtr.org/v1
AI_STUDIO_GATEWAY_ENABLE_AUTO=1
AI_STUDIO_GATEWAY_AUTO_STRATEGY=balanced
# Optional explicit failover, example:
# AI_STUDIO_GATEWAY_FAILOVER_JSON={"openrouter":[{"provider":"svrtr","model":"claude-sonnet-5"}]}
# To make intelligent routing the default chat route:
# AI_STUDIO_DEFAULT_PROVIDER=auto
# AI_STUDIO_DEFAULT_MODEL=auto/balanced

# P2-010 Docker Isolated Runtime
# Runtime is optional; AI Studio still starts when Docker is unavailable.
AI_STUDIO_ISOLATED_RUNTIME_ENABLED=1
# Optional artifact storage outside the default OS temp directory:
# AI_STUDIO_ISOLATED_RUNTIME_ROOT=C:\AIStudioRuntime
# Images are local-only at execution time (--pull=never). Prepare explicitly with prepare_p2_010_runtime.bat.
AI_STUDIO_RUNTIME_PYTHON_IMAGE=ai-studio-runtime-python:py313-v1
AI_STUDIO_RUNTIME_PYTEST_IMAGE=ai-studio-runtime-python:py313-v1
AI_STUDIO_RUNTIME_NODE_IMAGE=ai-studio-runtime-node:node22-v1
